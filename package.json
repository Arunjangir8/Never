{
  "name": "optimus-ai-agent",
  "version": "1.0.0",
  "description": "Local RAG-based coding assistant powered by Ollama + ChromaDB",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "index": "tsx src/index.ts --index",
    "watch": "tsx src/index.ts --watch",
    "debug": "tsx src/index.ts --debug",
    "test": "tsx --test src/*/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.27",
    "@langchain/core": "^1.1.41",
    "@langchain/google-genai": "^2.1.28",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.4.4",
    "chokidar": "^3.6.0",
    "chromadb": "^1.9.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
