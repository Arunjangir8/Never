# ─── Which brain to use ───────────────────────────────────────────────
# local | openrouter | groq | minimax | openai | gemini | anthropic
# Each reads its own KEY/MODEL below. Switch here, change nothing else.
# Leave as "local" to run fully offline via Ollama (no API key needed).
PROVIDER=local

# ─── Services ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_URL=http://localhost:8000
# Where ChromaDB keeps its data when Optimus starts it.
CHROMA_PATH=./chroma-data

# Start Ollama and ChromaDB automatically if they aren't already running.
# Already running in another terminal? Optimus reuses it, never double-starts.
AUTO_START=true
# On exit, stop the servers Optimus started. Ones it found already running
# are never touched, so a server from another terminal keeps going.
AUTO_STOP=true
# Pull missing models without the y/n prompt. These are multi-GB downloads.
AUTO_PULL_MODELS=false

# ─── The codebase Optimus reads and edits ─────────────────────────────
# Everything Optimus writes is confined to this folder.
PROJECT_PATH=./my-project
COLLECTION_NAME=optimus_codebase
TOP_K=5

# ─── Safety rails ─────────────────────────────────────────────────────
# Allow the model to create files that don't exist yet.
ALLOW_NEW_FILES=false
# Write <file>.optimus.bak before overwriting, so /revert <file> works.
BACKUP_BEFORE_WRITE=true
# Max chunks per `npm run debug` run — one LLM call each, so keep it small.
MAX_DEBUG_CHUNKS=10
# Run the Red/Blue bug-fixer on every save during `npm run watch`. Slow locally.
WATCH_AUTOFIX=false

# ─── Local models (ollama pull <name>) ────────────────────────────────
LOCAL_GENERAL_MODEL=gemma:2b
LOCAL_CODE_MODEL=qwen2.5-coder:7b
LOCAL_EMBED_MODEL=nomic-embed-text

# ─── Remote providers (only the one named in PROVIDER is read) ────────
# Never commit real keys. Put them in .env, which is gitignored.
# openrouter/groq/minimax/openai all speak the same protocol and share one
# client; each just carries its own URL so PROVIDER= is the only switch.

# OpenRouter — one key, every open model. Free ones end in ":free".
# openrouter.ai/keys · browse: openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# Groq — fastest, biggest free tier. console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# MiniMax — direct, has a $0 tier. platform.minimax.io
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5

# OpenAI itself. Paid. Set OPENAI_BASE_URL only for some other compatible host.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# console.anthropic.com. Paid.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
